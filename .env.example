# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection String (Local MongoDB or MongoDB Atlas URI)
# Example local: mongodb://127.0.0.1:27017/ecocycle
# Example Atlas: mongodb+srv://<username>:<password>@cluster0.mongodb.net/ecocycle?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/ecocycle

# JWT Authentication Secret Key
JWT_SECRET=ecocycle_jwt_secure_secret_key_2026_super_safe
JWT_EXPIRES_IN=7d

